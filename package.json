{
  "name": "workout-editor",
  "private": true,
  "version": "1.3.0",
  "description": "Open-source workout builder for Garmin-compatible devices",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @workout-editor/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vitest": "^4.0.5"
  }
}
